REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_TIERS={"default":{"algorithm":"token_bucket","capacity":20,"refill_rate":5},"premium":{"algorithm":"sliding_window","limit":200,"window_seconds":60}}
RATE_LIMITER_URL=http://localhost:8001
ROUTING_TABLE={"backend":["http://localhost:9000"]}
FAIL_OPEN=true

# Scheduler (Milestone 2)
DATABASE_URL=postgresql://agentops:agentops@localhost:5432/agentops
LEADER_TTL_SECONDS=10
DISPATCH_POLL_INTERVAL_SECONDS=1

# Worker Pool (Milestone 2)
SCHEDULER_URL=http://localhost:8002
MAX_RETRIES=3
BASE_BACKOFF_SECONDS=1.0
POLL_TIMEOUT_SECONDS=2.0

# Agent Ops / RAG (Milestone 3)
# EMBEDDING_PROVIDER=local needs no API key (self-hosted bge-small-en, downloaded
# on first run); "openai" needs OPENAI_API_KEY. LLM_PROVIDER always needs a real
# key ("openai" -> OPENAI_API_KEY, "anthropic" -> ANTHROPIC_API_KEY) since answer
# generation has no self-hosted option.
EMBEDDING_PROVIDER=local
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=
RAG_TOP_K=5
RAG_MIN_SCORE=0.3
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Agent Ops / Tool-Calling (Milestone 4)
# Reuses SCHEDULER_URL above. Same LLM_PROVIDER/key as Milestone 3 -- the
# same provider does both grounded-answer generation and tool-call decisions.
CONFIRMATION_TTL_SECONDS=300
